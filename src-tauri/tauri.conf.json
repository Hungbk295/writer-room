{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spy",
  "version": "2.0.0",
  "identifier": "com.dacthao.writerroom",
  "build": {
    "beforeBuildCommand": "bun run ui:build && bun run package:prepare",
    "beforeDevCommand": "bun --cwd packages/web dev",
    "devUrl": "http://127.0.0.1:5178",
    "frontendDist": "../packages/web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
