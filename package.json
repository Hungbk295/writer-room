{
  "name": "writer-room",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun test packages/spy packages/daemon",
    "typecheck": "tsc -p packages/spy/tsconfig.json --noEmit && tsc -p packages/daemon/tsconfig.json --noEmit",
    "daemon": "bun packages/daemon/src/index.ts",
    "spy": "bun packages/spy/src/cli.ts",
    "ui:build": "bun --cwd packages/web vite build",
    "app:macos": "bunx @tauri-apps/cli dev",
    "app:build": "bun run ui:build && bunx @tauri-apps/cli build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
